# Settings for the encoder worker (worker/). Copy to worker/.env (gitignored)
# for a local run, or to /opt/sloptube-encoder/.env on the encoder box
# (see ops/encoder/README.md). Run it locally with:
#   npm ci --prefix worker
#   node --env-file=worker/.env worker/index.mjs
# It needs ffmpeg and ffprobe on the PATH.

# Required. The project URL (https://<project-ref>.supabase.co) and the
# Supabase secret key (or the legacy service_role key) from the project's
# API keys page. The secret key can read and change everything in the
# database: it lives only here, never in the repository.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Required. The same R2 bucket the website uploads to, with an API token that
# has Object Read & Write on that bucket only.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Or, instead of R2, any S3 compatible bucket (a Railway bucket, for example).
# When S3_ENDPOINT is set these are used and the R2 settings are not needed.
# On Railway, reference the website service's settings, like ${{sloptube.S3_BUCKET}}.
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# Optional with the S3 settings: the region (default "auto") and whether to use
# path style addresses (default true).
S3_REGION=
S3_FORCE_PATH_STYLE=

# Optional. Shown in encode_jobs.worker (default: the host name).
WORKER_NAME=
# Optional. Where sources are downloaded and encoded (default: the temp folder).
WORK_DIR=
# Optional. Where the busy marker for the update script lives (default: none).
STATE_DIR=
# Optional. The public bucket domain (same as the website's MEDIA_PUBLIC_URL),
# so thumbnail_url is filled in.
MEDIA_PUBLIC_URL=
# Optional. The website's address, like https://tube.example.com, for the links
# in Yapin' announcements. Without it none are posted.
SITE_URL=
